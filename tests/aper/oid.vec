# Hand-derived from X.691 (02/2021) 24, 25 and X.690 8.19, 8.20, ALIGNED.
#
# 1.2.840.113549: 40 x 1 + 2 = 42 (2a), 840 = 6 x 128 + 72 (86 48),
# 113549 = 6 x 16384 + 118 x 128 + 13 (86 f7 0d): 6 octets.
accept ObjId 062a864886f70d "1.2.840.113549"
# 2.999.3: 80 + 999 = 1079 = 8 x 128 + 55 (88 37), then 03 (X.690 8.19.4)
accept ObjId 03883703 "2.999.3"
accept ObjId 0100 "0.0"
accept ObjId 0127 "0.39"
accept ObjId 0128 "1.0"
accept ObjId 0150 "2.0"
reject ObjId 00  # no subidentifier: an OBJECT IDENTIFIER has two arcs at least
reject ObjId 0181  # the last octet continues a subidentifier
reject! ObjId 02807f  # asn1c and pycrate accept it, as 2.47; a subidentifier begins with 80: not the fewest octets (8.19.2)
reject ObjId 03012a80  # ... and so it is after another
accept ObjId 0401818000 "0.1.16384"  # 80 inside a subidentifier is a digit: 16384 = 81 80 00
# RELATIVE-OID 8571.3.2: 8571 = 66 x 128 + 123 (c2 7b)
accept! RelOid 04c27b0302 "8571.3.2"
reject! RelOid 00  # no arc (X.680 33.3: one at least); asn1c and pycrate accept it, as ""
# a BOOLEAN, padding, the length, the contents
accept S 000100 {"a": false, "o": "0.0"}
accept! S c0010002012a {"a": true, "o": "0.0", "r": "1.42"}
# the list's length (1..3) in 2 bits, then each OID from an octet boundary
accept L 4001280150 ["1.0", "2.0"]

# rasn 0.28 (rasn-compiler 0.16) holds an arc in 32 bits and keeps the low 32
# of a wider one: 14132620730562250273 decodes as 914097697 (tools/xcheck.py
# counts those as known). rasn-compiler makes a RELATIVE-OID an OBJECT
# IDENTIFIER, so 8571.3.2 decodes as 2.8491.3.2. And rasn's encoder does not
# octet-align an OBJECT IDENTIFIER that is a SEQUENCE OF's element (X.691 24:
# "octet-aligned in the ALIGNED variant"): ["2.17"] it sends as 00 58 40, where
# X.691's is 00 01 61; it decodes X.691's.
deviates rasn RelOid
deviates rasn S
deviates-encode rasn L
