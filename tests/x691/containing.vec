# xcheck: --containing decode
# Hand-derived from X.682 11 and X.691 11.1-11.2: the contents are the T's
# complete encoding (padded to octets; one 0 octet if empty) after an
# unconstrained octet length, as an open type. Decoded as the T; checked
# against pycrate, which decodes it too (asn1c keeps the octets).
accept Outer 40816000 {"x":true,"inner":{"containing":{"a":5,"b":true}}}  # opt bit 0, x, length 2, 05 80
accept Outer c0816000bfc000 {"x":true,"inner":{"containing":{"a":5,"b":true}},"opt":{"containing":{"a":255,"b":false}}}
reject! Outer 40816040  # contents 05 81: a padding bit is 1. pycrate accepts
reject! Outer 40c1600000  # contents 05 80 00: an octet more than the complete encoding. pycrate accepts
reject Outer 404140  # contents 05: too short for an Inner
accept Empty 0100 {"n":{"containing":null}}  # NULL encodes to no bits: one 0 octet (11.1.3)
reject Empty 00  # length 0: never a complete encoding
reject Empty 0101  # the one octet is not 0
reject! Empty 020000  # two octets. pycrate accepts
accept Wrapped 020100 {"containing":{"a":1,"b":false}}
accept Nest 048100c000 {"c":{"containing":{"o":{"containing":{"a":1,"b":true}}}}}  # o, length 2, 01 c0 (25 bits, 4 octets)
accept Nest 0150 {"c":{"containing":{"i":5}}}  # i, 101: 4 bits in one octet
accept WrappedList 00804000 [{"containing":{"a":1,"b":false}}]  # count 1 in 2 bits, then a Wrapped
accept WrappedList 4080400080a000 [{"containing":{"a":1,"b":false}},{"containing":{"a":2,"b":true}}]
