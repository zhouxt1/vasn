# asn1c's NR decoder, from the C that VUPER's harness ships (generated by
# asn1c from the same nr-rrc-17.3.0 schema), built out of tree so the VUPER
# checkout ../build.sh fetches is untouched.
#
#   make                                   obj/bench_asn1c, -O2
#   make O=dbg OPT="-O0 -g -fcommon -DASN_EMIT_DEBUG=1"   a tracing build in dbg/
SRC := ../VUPER/diff_test/fuzz/asn1c_test
include $(SRC)/Makefile.am.libasncodec
vpath %.c $(SRC)

CC ?= gcc
OPT ?= -O2
O ?= obj
CFLAGS := $(OPT) $(ASN_MODULE_CFLAGS) -DASN_DISABLE_BER_SUPPORT -DASN_DISABLE_XER_SUPPORT \
          -DASN_DISABLE_OER_SUPPORT -DASN_DISABLE_APER_SUPPORT -DASN_PDU_COLLECTION -I$(SRC) -w
OBJ := $(addprefix $(O)/,$(ASN_MODULE_SRCS:.c=.o))

$(O)/bench_asn1c: bench.c $(O)/libasncodec.a
	$(CC) $(CFLAGS) -o $@ $< $(O)/libasncodec.a -lm

$(O)/libasncodec.a: $(OBJ)
	$(AR) rcs $@ $^

$(O)/%.o: %.c | $(O)
	$(CC) $(CFLAGS) -c $< -o $@

$(O):
	mkdir -p $(O)

clean:
	rm -rf obj dbg

